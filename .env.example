# ---------------------------------------------------------------------------
# Yala Energy — environment configuration
# Copy to `.env` for local development. Never commit a populated `.env`.
# Only PUBLIC_* values are exposed to the browser bundle. Keep secrets out.
# ---------------------------------------------------------------------------

# Canonical origin used for sitemap, robots.txt, canonical tags and OG URLs.
SITE_URL="https://yalaenergy.co.zm"

# Enquiry form endpoint.
# LEAVE EMPTY to run the forms in clearly-labelled DEMO MODE: nothing is sent,
# and the UI tells the visitor so explicitly.
# Set to your own serverless handler (see server/enquiry-handler.mjs) or a
# verified form service endpoint to go live.
PUBLIC_ENQUIRY_ENDPOINT=""

# ---------------------------------------------------------------------------
# Server-side only (used by server/enquiry-handler.mjs — never bundled by Astro)
# ---------------------------------------------------------------------------
# Where qualified enquiries are delivered.
ENQUIRY_TO_ADDRESS="info@yalaenergy.co.zm"
# Transactional email provider API key (e.g. Resend, Postmark, SES).
ENQUIRY_MAIL_API_KEY=""
# Comma-separated list of origins permitted to POST to the handler.
ENQUIRY_ALLOWED_ORIGINS="https://yalaenergy.co.zm,https://www.yalaenergy.co.zm"
