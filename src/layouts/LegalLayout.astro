---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  path: string;
  lede: string;
  updated: string;
  noindex?: boolean;
}

const { title, description, path, lede, updated, noindex = false } = Astro.props;
---

<BaseLayout title={title} description={description} path={path} noindex={noindex}>
  <section class="legal-hero stage--forest" aria-labelledby="legal-title">
    <div class="shell shell--narrow legal-hero__inner">
      <p class="eyebrow">Legal</p>
      <h1 class="title-lg legal-hero__title" id="legal-title">{title}</h1>
      <p class="legal-hero__lede">{lede}</p>
      <p class="legal-hero__updated">Last updated: {updated}</p>
    </div>
  </section>

  <section class="stage stage--paper">
    <div class="shell shell--narrow">
      <div class="legal-body">
        <slot />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .legal-hero {
    padding-block: calc(var(--header-height) + var(--space-2xl)) var(--section-y-tight);
    background: var(--forest-900);
    color: var(--text-on-ink-muted);
  }

  .legal-hero__inner {
    display: grid;
    gap: var(--space-md);
    justify-items: start;
  }

  .legal-hero__title {
    color: #fff;
    max-width: 24ch;
  }

  .legal-hero__lede {
    max-width: 62ch;
    margin: 0;
    color: #cbd9cd;
    font-size: var(--step-0);
    line-height: 1.6;
  }

  .legal-hero__updated {
    margin: 0;
    padding-block-start: var(--space-sm);
    border-block-start: 1px solid var(--rule-on-ink);
    color: var(--forest-300);
    font-size: var(--step--2);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .legal-body {
    display: grid;
    gap: var(--space-xl);
    max-width: 72ch;
  }

  .legal-body :global(h2) {
    margin-block-start: var(--space-lg);
    font-size: var(--step-2);
    letter-spacing: var(--tracking-tight);
  }

  .legal-body :global(h2:first-of-type) {
    margin-block-start: 0;
  }

  .legal-body :global(h3) {
    font-size: var(--step-1);
  }

  .legal-body :global(p) {
    margin: 0;
    line-height: 1.68;
    text-wrap: pretty;
  }

  .legal-body :global(section) {
    display: grid;
    gap: var(--space-md);
  }

  .legal-body :global(ul) {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding-inline-start: 1.2rem;
    line-height: 1.6;
  }

  .legal-body :global(a) {
    color: var(--forest-700);
    text-decoration: underline;
    text-decoration-color: var(--lime-500);
    text-decoration-thickness: 2px;
  }

  .legal-body :global(dl) {
    display: grid;
    gap: var(--space-md);
    margin: 0;
  }

  .legal-body :global(dt) {
    color: var(--text-strong);
    font-weight: 600;
  }

  .legal-body :global(dd) {
    margin: 0;
    line-height: 1.6;
  }
</style>
