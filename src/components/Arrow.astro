---
interface Props {
  class?: string;
  size?: number;
}
const { class: className = 'btn__arrow', size = 14 } = Astro.props;
---
<svg
  class={className}
  width={size}
  height={Math.round((size / 14) * 10)}
  viewBox="0 0 14 10"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <path
    d="M1 5h11M8.4 1.2 12.2 5 8.4 8.8"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    stroke-linejoin="round"
  />
</svg>
