---
import Logo from './Logo.astro';
import { PRIMARY_NAV } from '../data/site';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

const isCurrent = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<header class="header" data-header>
  <div class="header__inner shell shell--wide">
    <a class="header__brand" href="/" aria-label="Yala Energy — home">
      <Logo variant="full" tone="dark" size={34} />
    </a>

    <nav class="header__nav" aria-label="Primary">
      <ul class="header__list plain">
        {
          PRIMARY_NAV.map((item) => (
            <li>
              <a
                class="header__link"
                href={item.href}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header__actions">
      <a class="btn btn--accent header__cta" href="/contact/">
        Discuss a Project
        <svg class="btn__arrow" width="14" height="10" viewBox="0 0 14 10" fill="none" aria-hidden="true">
          <path d="M1 5h11M8.4 1.2 12.2 5 8.4 8.8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>

      <button
        class="header__toggle"
        type="button"
        aria-expanded="false"
        aria-controls="nav-drawer"
        data-nav-toggle
      >
        <span class="header__toggle-bars" aria-hidden="true"><span></span><span></span></span>
        <span class="visually-hidden">Open navigation menu</span>
      </button>
    </div>
  </div>
</header>

<!-- Mobile drawer. `hidden` until opened by script; the no-JavaScript route is
     the inline list in the footer, which every page renders. -->
<div class="drawer on-ink" id="nav-drawer" hidden data-nav-drawer>
  <div class="drawer__panel">
    <div class="drawer__top">
      <Logo variant="full" tone="ink" size={32} />
      <button class="drawer__close" type="button" data-nav-close>
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
          <path d="M2 2l14 14M16 2 2 16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
        </svg>
        <span class="visually-hidden">Close navigation menu</span>
      </button>
    </div>

    <nav aria-label="Primary (mobile)">
      <ul class="drawer__list plain">
        {
          PRIMARY_NAV.map((item, index) => (
            <li>
              <a
                class="drawer__link"
                href={item.href}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
              >
                <span class="drawer__index">{String(index + 1).padStart(2, '0')}</span>
                <span class="drawer__label">
                  {item.label}
                  {item.description && <span class="drawer__desc">{item.description}</span>}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="drawer__foot">
      <a class="btn btn--accent btn--block" href="/contact/">Discuss a Project</a>
      <a class="drawer__mail" href="mailto:info@yalaenergy.co.zm">info@yalaenergy.co.zm</a>
    </div>
  </div>
</div>

<style>
  .header {
    position: sticky;
    z-index: 100;
    top: 0;
    background: color-mix(in oklab, var(--paper) 86%, transparent);
    backdrop-filter: blur(14px) saturate(1.1);
    border-block-end: 1px solid transparent;
    transition:
      border-color var(--dur-mid) var(--ease-out),
      background-color var(--dur-mid) var(--ease-out);
  }

  .header[data-scrolled='true'] {
    border-block-end-color: var(--rule);
    background: color-mix(in oklab, var(--paper) 94%, transparent);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
    min-height: var(--header-height);
  }

  .header__brand {
    flex: none;
    text-decoration: none;
    border-radius: var(--radius-xs);
  }

  .header__nav {
    display: none;
  }

  .header__list {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2vw, 2.1rem);
    margin: 0;
  }

  .header__link {
    position: relative;
    display: block;
    padding-block: 0.4rem;
    color: var(--text-body);
    font-size: var(--step--1);
    font-weight: 500;
    letter-spacing: 0.005em;
    text-decoration: none;
    white-space: nowrap;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .header__link::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    bottom: -0.1rem;
    height: 2px;
    background: var(--lime-500);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-mid) var(--ease-out);
  }

  .header__link:hover {
    color: var(--text-strong);
  }

  .header__link:hover::after,
  .header__link[aria-current='page']::after {
    transform: scaleX(1);
  }

  .header__link[aria-current='page'] {
    color: var(--text-strong);
    font-weight: 600;
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .header__cta {
    display: none;
    min-height: 2.75rem;
    padding: 0.6rem 1.15rem;
  }

  .header__toggle {
    display: grid;
    place-items: center;
    width: 2.9rem;
    height: 2.9rem;
    padding: 0;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-sm);
    background: transparent;
    cursor: pointer;
    transition: border-color var(--dur-fast) var(--ease-out);
  }

  .header__toggle:hover {
    border-color: var(--forest-900);
  }

  .header__toggle-bars {
    display: grid;
    gap: 5px;
    width: 1.1rem;
  }

  .header__toggle-bars > span {
    height: 1.5px;
    background: var(--ink-900);
    transition: transform var(--dur-mid) var(--ease-out);
  }

  .header__toggle[aria-expanded='true'] .header__toggle-bars > span:first-child {
    transform: translateY(3.25px) rotate(45deg);
  }

  .header__toggle[aria-expanded='true'] .header__toggle-bars > span:last-child {
    transform: translateY(-3.25px) rotate(-45deg);
  }

  @media (min-width: 60rem) {
    .header__nav,
    .header__cta {
      display: block;
    }

    .header__cta {
      display: inline-flex;
    }

    .header__toggle {
      display: none;
    }
  }

  /* --- Drawer --- */
  .drawer {
    position: fixed;
    z-index: 150;
    inset: 0;
    display: flex;
    justify-content: flex-end;
    background: color-mix(in oklab, var(--forest-950) 55%, transparent);
    opacity: 0;
    transition: opacity var(--dur-mid) var(--ease-out);
  }

  .drawer[data-open='true'] {
    opacity: 1;
  }

  .drawer[hidden] {
    display: none;
  }

  .drawer__panel {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
    width: min(26rem, 100%);
    height: 100%;
    padding: var(--space-lg) var(--gutter) var(--space-xl);
    overflow-y: auto;
    background: var(--forest-950);
    transform: translateX(14%);
    transition: transform var(--dur-mid) var(--ease-out);
  }

  .drawer[data-open='true'] .drawer__panel {
    transform: translateX(0);
  }

  .drawer__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    min-height: calc(var(--header-height) - var(--space-lg));
  }

  .drawer__close {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--rule-on-ink-strong);
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--text-on-ink);
    cursor: pointer;
  }

  .drawer__close:hover {
    border-color: var(--lime-400);
    color: var(--lime-400);
  }

  .drawer__list {
    margin: 0;
    border-block-start: 1px solid var(--rule-on-ink);
  }

  .drawer__link {
    display: grid;
    grid-template-columns: 2.2rem minmax(0, 1fr);
    gap: 0.9rem;
    padding-block: var(--space-md);
    border-block-end: 1px solid var(--rule-on-ink);
    color: var(--text-on-ink);
    text-decoration: none;
  }

  .drawer__index {
    color: var(--lime-400);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    padding-block-start: 0.45em;
  }

  .drawer__label {
    display: grid;
    gap: 0.2rem;
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 600;
    letter-spacing: var(--tracking-tight);
    line-height: 1.15;
  }

  .drawer__desc {
    color: var(--text-on-ink-muted);
    font-family: var(--font-body);
    font-size: var(--step--2);
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1.4;
  }

  .drawer__link[aria-current='page'] .drawer__label {
    color: var(--lime-300);
  }

  .drawer__foot {
    display: grid;
    gap: var(--space-md);
    margin-block-start: auto;
  }

  .drawer__mail {
    color: var(--text-on-ink-muted);
    font-size: var(--step--1);
    text-align: center;
    text-decoration: underline;
    text-decoration-color: var(--lime-600);
    text-underline-offset: 0.25em;
  }
</style>
